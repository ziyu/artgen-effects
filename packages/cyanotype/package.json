{
  "name": "artgen-cyanotype",
  "version": "0.1.0",
  "description": "A deterministic blue-and-paper cyanotype filter for RGBA images.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Artgen contributors",
  "homepage": "https://artgen.net/en/tools/cyanotype-filter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/artgen-effects.git",
    "directory": "packages/cyanotype"
  },
  "bugs": {
    "url": "https://github.com/ziyu/artgen-effects/issues"
  },
  "keywords": [
    "cyanotype",
    "cyanotype-filter",
    "duotone",
    "blueprint",
    "artgen",
    "image-processing",
    "cloudflare-workers",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
