{
  "name": "artgen-pixel",
  "version": "0.1.0",
  "description": "Convert RGBA images to pixel art with median-cut palettes and optional dithering.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Artgen contributors",
  "homepage": "https://artgen.net/en/tools/image-to-pixel-art",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/artgen-effects.git",
    "directory": "packages/pixel"
  },
  "bugs": {
    "url": "https://github.com/ziyu/artgen-effects/issues"
  },
  "keywords": [
    "pixel",
    "pixel-art",
    "pixel-art-generator",
    "image-to-pixel-art",
    "dithering",
    "artgen",
    "image-processing",
    "cloudflare-workers",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
